{
  "name": "CbM_mobile_app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start -c",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "prebuild": "./scripts/prebuild.sh",
    "prebuild:clean": "expo prebuild --clean",
    "prebuild:android": "expo prebuild --platform android --clean && ./scripts/post-prebuild.sh",
    "prebuild:ios": "expo prebuild --platform ios --clean && ./scripts/post-prebuild.sh",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx,css}\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css}\" && eslint \"**/*.{js,jsx,ts,tsx,css}\" --fix",
    "format:check": "prettier -c \"**/*.{js,jsx,ts,tsx,json,css}\"",
    "type-check": "tsc --noEmit",
    "test": "echo \"No tests configured yet\"",
    "test:coverage": "echo \"No tests configured yet\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.18",
    "@rn-primitives/portal": "^1.3.0",
    "@rn-primitives/select": "^1.2.0",
    "@rn-primitives/slot": "^1.2.0",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "54.0.15",
    "expo-build-properties": "~0.13.2",
    "expo-constants": "~18.0.9",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.7",
    "expo-router": "~6.0.13",
    "expo-splash-screen": "^31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.7",
    "husky": "^9.1.7",
    "i18next": "^25.6.0",
    "lucide-react": "^0.545.0",
    "lucide-react-native": "^0.545.0",
    "md5": "^2.3.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.1.3",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.3",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@types/react": "~19.1.17",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": [
      "bun run format"
    ]
  }
}
